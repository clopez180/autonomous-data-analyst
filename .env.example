# Pick ONE provider: anthropic | groq | openrouter
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=sk-ant-your-key-here
# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter (free models): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: override the model. Defaults: claude-sonnet-5-5 | openai/gpt-oss-120b | openrouter/free
# LLM_MODEL=

PYDANTIC_AI_NO_BANNER=1
# Optional: Logfire / any OpenTelemetry backend for tracing
# LOGFIRE_TOKEN=
